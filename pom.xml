<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.garganttua.api</groupId>
	<artifactId>garganttua-api-example</artifactId>
	<version>3.0.0-ALPHA01</version>
	<packaging>jar</packaging>

	<name>garganttua-api-example</name>
	<description>Standalone example of garganttua-api v3 with multi-tenancy, authenticator, signed authorizations and per-user keys.</description>

	<!--
	  Reflection mode is selected via -Dreflection=<mode>, where <mode> is one of:
	    aot      → AOT providers only. Pulls garganttua-starter-aot.
	    runtime  → JDK-reflection + classpath scanner. Pulls garganttua-starter-runtime.
	    hybrid   → both stacks. AOT @20 wins for @Reflected user types,
	               runtime @10 catches the rest. Default when -Dreflection
	               is not set. Pulls garganttua-starter-hybrid.
	    native   → AOT + GraalVM Feature for native-image. Pulls
	               garganttua-starter-native. The consumer is still expected
	               to add org.graalvm.buildtools:native-maven-plugin to its
	               build to actually produce a binary.

	  Each profile contributes a single starter dep — no SPI artefacts are
	  listed individually. The matrix of providers/scanners on the runtime
	  classpath is controlled entirely by the starter chosen.

	  Usage:
	    mvn clean package                       # → hybrid (default)
	    mvn clean package -Dreflection=aot      # → full AOT
	    mvn clean package -Dreflection=runtime  # → full runtime reflection
	    mvn clean package -Dreflection=hybrid   # → explicit hybrid
	    mvn clean package -Dreflection=native   # → AOT + native-image config
	-->

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>25</java.version>
		<garganttua.api.version>3.0.0-ALPHA01</garganttua.api.version>
		<garganttua.core.version>2.0.0-ALPHA02</garganttua.core.version>

		<slf4j.version>2.0.13</slf4j.version>
		<native.maven.plugin.version>0.10.6</native.maven.plugin.version>

		<!-- Drives the AOT processor's DirectBinderGenerator. true in
		     aot/hybrid/native modes (emits AOTClass_*.java), overridden to
		     false in the reflection-runtime profile where the binders are
		     dead weight. -->
		<garganttua.direct.binders>true</garganttua.direct.binders>
	</properties>

	<repositories>
		<repository>
			<id>github-garganttua-core</id>
			<url>https://maven.pkg.github.com/garganttua/garganttua-core</url>
		</repository>
		<repository>
			<id>github-garganttua-api</id>
			<url>https://maven.pkg.github.com/garganttua/garganttua-api</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- mode-agnostic api/core deps -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-commons</artifactId>
			<version>${garganttua.api.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-core</artifactId>
			<version>${garganttua.api.version}</version>
			<exclusions>
				<!-- api-core depends on garganttua-aot-reflection directly.
				     Excluded here so the AOT provider is opt-in via the
				     starter (aot / hybrid / native modes), and does NOT
				     leak into runtime mode. To be removed once api-core
				     stops pinning the SPI provider artefact directly. -->
				<exclusion>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-aot-reflection</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Server mode: Javalin HTTP transport + Jackson JSON serializer.
		     binding-javalin brings io.javalin + the @Protocol/@Interface;
		     binding-jackson brings the @Serializer. Both are auto-detected at
		     bootstrap (scan surface com.garganttua). Headless mode wires no
		     interface, so no server starts. -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-binding-javalin</artifactId>
			<version>${garganttua.api.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-binding-jackson</artifactId>
			<version>${garganttua.api.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-reflection</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-runtime</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-injection</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-mapper</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-workflow</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-script</artifactId>
			<version>${garganttua.core.version}</version>
			<!-- Exclude Logback so slf4j-simple (configured via
			     simplelogger.properties) is the only SLF4J provider. -->
			<exclusions>
				<exclusion>
					<groupId>ch.qos.logback</groupId>
					<artifactId>logback-classic</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-execution</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-commons</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-crypto</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>
		<!-- Observability annotations (@Observer) + LogEvent. Was reachable
		     transitively until core 02924f53 (Diagnostics → observable Logger)
		     re-wired the modules; the example uses @Observer directly
		     (CoreLoggingObserver/CoreStatsObserver) so it must depend on it. -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-observability</artifactId>
			<version>${garganttua.core.version}</version>
		</dependency>

		<!-- third-party -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>reflection-aot</id>
			<activation>
				<property>
					<name>reflection</name>
					<value>aot</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-starter-aot</artifactId>
					<version>${garganttua.core.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>reflection-runtime</id>
			<activation>
				<property>
					<name>reflection</name>
					<value>runtime</value>
				</property>
			</activation>
			<properties>
				<garganttua.direct.binders>false</garganttua.direct.binders>
			</properties>
			<dependencies>
				<dependency>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-starter-runtime</artifactId>
					<version>${garganttua.core.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>reflection-hybrid-default</id>
			<activation>
				<property>
					<name>!reflection</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-starter-hybrid</artifactId>
					<version>${garganttua.core.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>reflection-hybrid-explicit</id>
			<activation>
				<property>
					<name>reflection</name>
					<value>hybrid</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-starter-hybrid</artifactId>
					<version>${garganttua.core.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
		</profile>

		<profile>
			<id>reflection-native</id>
			<activation>
				<property>
					<name>reflection</name>
					<value>native</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.garganttua.core</groupId>
					<artifactId>garganttua-starter-native</artifactId>
					<version>${garganttua.core.version}</version>
					<type>pom</type>
				</dependency>
			</dependencies>
			<!-- GraalVM build plugin. The starter only brings the AOT Feature
			     (auto-activated via META-INF/native-image); the consumer wires
			     the plugin itself (cf. garganttua-starter-native README). Must
			     run on a GraalVM JDK 25 (e.g. JAVA_HOME=~/.sdkman/.../25.0.3-graal).
			     no enable-preview flag since the JDK 25 migration. -->
			<build>
				<plugins>
					<!-- garganttua-core's AOT registry aggregator: scans the compiled
					     AOT descriptors (entities, DTOs, business classes…) and emits
					     META-INF/native-image/<g>/<a>/{reflect-config,resource-config}.json,
					     consumed automatically by native-image. Declares the consumer's
					     entities/DTOs for native reflection from the same AOT source of
					     truth — no hand-written JSON. -->
					<plugin>
						<groupId>com.garganttua.core</groupId>
						<artifactId>garganttua-aot-maven-plugin</artifactId>
						<version>${garganttua.core.version}</version>
						<executions>
							<execution>
								<id>aggregate-aot-registry</id>
								<goals>
									<!-- aggregate-index: merge every dependency JAR's
									     META-INF/garganttua/index/<annotation> into this module's
									     output, so the native build sees the COMPLETE annotation
									     index (classpath would otherwise shadow same-path index
									     files across jars — e.g. @ChildContext RuntimeContextFactory).
									     aggregate-registry: emit reflect-config/resource-config. -->
									<goal>aggregate-index</goal>
									<goal>aggregate-registry</goal>
								</goals>
								<phase>process-classes</phase>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>${native.maven.plugin.version}</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>garganttua-api-example</imageName>
							<mainClass>com.garganttua.api.example.ExampleApplication</mainClass>
							<buildArgs>
								<buildArg>--no-fallback</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<compilerArgs>
						<arg>-parameters</arg>
						<!-- Drives DirectBinderGenerator. Property is overridden
						     to false in the reflection-runtime profile. -->
						<arg>-Agarganttua.direct.binders=${garganttua.direct.binders}</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>com.garganttua.core</groupId>
							<artifactId>garganttua-aot-annotation-processor</artifactId>
							<version>${garganttua.core.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<!-- Run with: mvn exec:exec
				     Forks a fresh JVM (exec:java reuses Maven's). Since the
				     JDK 25 migration the build no longer uses preview features
				     (ScopedValue is final in 25), so no enable-preview flag is
				     needed at compile or run time. Requires a JDK 25 runtime. -->
				<configuration>
					<executable>java</executable>
					<arguments>
						<!-- Logging is driven entirely by
						     src/main/resources/simplelogger.properties
						     (on the classpath at target/classes). We do
						     NOT pass -Dorg.slf4j.simpleLogger.* here: in
						     slf4j-simple, system properties take
						     precedence over the file, so any such flag
						     would silently override simplelogger.properties.
						     To change the level, edit that file. -->
						<argument>-classpath</argument>
						<classpath />
						<argument>com.garganttua.api.example.ExampleApplication</argument>
					</arguments>
				</configuration>
			</plugin>
			<plugin>
				<!-- Builds an executable uber-jar at
				     target/garganttua-api-example-${project.version}.jar
				     bundling every runtime dependency and a Main-Class
				     manifest entry. Run with (JDK 25, no preview flag needed):
				       java -jar target/garganttua-api-example-3.0.0-ALPHA01.jar -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<!-- Drop signature files from signed
										     jars; otherwise the JVM rejects
										     the shaded jar with
										     "Invalid signature file digest". -->
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.garganttua.api.example.ExampleApplication</mainClass>
								</transformer>
								<!-- Merge SPI files
								     (META-INF/services/*) so providers
								     like slf4j-simple stay discoverable. -->
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<!-- Merge garganttua-core's compile-time
								     annotation indices. Without these
								     AppendingTransformer entries, each
								     dependency's index file at
								     META-INF/garganttua/index/<fqn>
								     overwrites the others in the fat jar
								     and the framework's auto-detection
								     finds nothing (e.g. @Observer beans
								     never get registered, observers
								     never notified). One transformer per
								     index file because maven-shade has
								     no glob-pattern merger. -->
								<!-- reflection / dsl / dependency -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.reflection.annotations.Reflected</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.reflection.annotations.ReflectedBuilder</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.reflection.annotations.Indexed</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.bootstrap.annotations.Bootstrap</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.dsl.annotations.Scan</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.dsl.dependency.DependsOn</resource>
								</transformer>
								<!-- expression -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.expression.annotations.Expression</resource>
								</transformer>
								<!-- injection -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.BeanProvider</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.ChildContext</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Fixed</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Null</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Property</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.PropertyProvider</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Prototype</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Provider</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.injection.annotations.Resolver</resource>
								</transformer>
								<!-- mapper -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mapper.annotations.FieldMappingRule</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mapper.annotations.FieldMappingRules</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mapper.annotations.MappingIgnore</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mapper.annotations.ObjectMappingRule</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mapper.annotations.ObjectMappingRules</resource>
								</transformer>
								<!-- mutex -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mutex.annotations.Mutex</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.mutex.annotations.MutexFactory</resource>
								</transformer>
								<!-- runtime -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Catch</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Code</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Condition</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Context</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Exception</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.ExceptionMessage</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.FallBack</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/garganttua/index/com.garganttua.core.runtime.annotations.Input</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
